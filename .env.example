# Copy this file to .env.local. Never put your real key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# select: choose among eligible candidates; explain: retain the calculated selection.
AI_RECOMMENDATION_ROLE=select
AI_TIMEOUT_MS=25000
AI_CANDIDATE_LIMIT=8
# Local npm run start demo only. Keep false for public deployment until auth is implemented.
AI_DEMO_ENABLED=false
